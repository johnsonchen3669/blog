---
import '@unocss/reset/tailwind.css'
import '@fontsource-variable/recursive'
import '@fontsource/noto-sans-tc/400.css'
import '@fontsource/noto-sans-tc/600.css'
import '@fontsource/noto-sans-tc/700.css'
import '@fontsource/ibm-plex-mono/400.css'
import '@fontsource/ibm-plex-mono/600.css'
import '~/styles/prose.css'
import '~/styles/markdown.css'
import '~/styles/page.css'
import '~/styles/main.css'

import Head from '~/components/base/Head.astro'
import Link from '~/components/base/Link.astro'
import NavBar from '~/components/nav/NavBar.astro'
import BackLink from '~/components/widgets/BackLink.astro'
import Footer from '~/components/base/Footer.astro'
import ToTopButton from '~/components/widgets/ToTopButton.astro'
import Backdrop from '~/components/base/Backdrop.astro'

import { SITE, FEATURES } from '~/config'
import { withBasePath } from '~/utils/path'

interface Props {
  title?: string
  description?: string
  ogImage?: string | boolean
  pubDate?: string
  lastModDate?: string
}

const { title, description, ogImage, pubDate, lastModDate } = Astro.props
const { slideEnterAnim } = FEATURES
const enableSlideEnterAnim = Array.isArray(slideEnterAnim) && slideEnterAnim[0]
const style = enableSlideEnterAnim
  ? { '--enter-step': `${slideEnterAnim[1].enterStep}ms` }
  : undefined
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <Head {title} {description} {ogImage} {pubDate} {lastModDate} />
  </head>
  <body
    class="site-body"
    {style}
    data-no-sliding={enableSlideEnterAnim ? undefined : ''}
  >
    <Link href="#main" class="skip-link">跳到主要內容</Link>
    <NavBar />
    <main id="main" class="site-main">
      <slot />
      {
        Astro.url.pathname !== withBasePath('/') && (
          <footer class="article-backlink print:hidden">
            <slot name="share" />
            <BackLink />
          </footer>
        )
      }
      <slot name="giscus" />
    </main>
    <Footer />
    <ToTopButton />
    <Backdrop />
    <script>
      import '~/scripts/base-layout-client'
    </script>
  </body>
</html>
