---
import Link from '~/components/base/Link.astro'
import { formatDate } from '~/utils/datetime'

interface Props {
  idx: number
  collectionType: string
  href?: string
  redirect?: string
  postSlug?: string
  title: string
  video?: boolean
  radio?: boolean
  date: string | Date
  minutesRead?: number
  platform?: string
}

const { href, redirect, title, date, minutesRead } = Astro.props
---

<Link
  class="field-post-row"
  href={redirect ?? href}
  external={Boolean(redirect)}
>
  <time datetime={new Date(date).toISOString()}>{formatDate(date)}</time>
  <strong>{title}</strong>
  <span
    >{
      typeof minutesRead === 'number' && minutesRead > 0
        ? `${minutesRead} min read`
        : 'Field note'
    }</span
  >
</Link>
