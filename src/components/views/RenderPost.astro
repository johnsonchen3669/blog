---
import { render } from 'astro:content'

import BaseLayout from '~/layouts/BaseLayout.astro'
import PostMeta from '~/components/base/PostMeta.astro'
import PostTaxonomy from '~/components/blog/PostTaxonomy.astro'
import Warning from '~/components/base/Warning.astro'
import Toc from '~/components/toc/Toc.astro'
import ShareLink from '~/components/widgets/ShareLink.astro'
import Giscus from '~/components/widgets/Giscus.astro'
import ImageViewer from '~/components/widgets/ImageViewer.astro'
import { FEATURES } from '~/config'
import { getPostSeriesMeta } from '~/utils/blog'

import type { CollectionEntry } from 'astro:content'

interface Props {
  post: CollectionEntry<'blog'>
  isCommentable?: boolean
}

const { post, isCommentable = false } = Astro.props
const { toc, share, giscus, search } = FEATURES
const { data: frontmatter } = post
const { Content, headings, remarkPluginFrontmatter } = await render(post)

const pubDate = frontmatter.pubDate.toISOString()
const lastModDate = frontmatter.lastModDate
  ? frontmatter.lastModDate.toISOString()
  : undefined
const minutesRead =
  frontmatter.minutesRead ?? (remarkPluginFrontmatter.minutesRead as number)
const series = getPostSeriesMeta(post)
const tocEnabled = Array.isArray(toc) && toc[0] && frontmatter.toc
const shareEnabled = Array.isArray(share) && share[0] && frontmatter.share
const giscusEnabled =
  isCommentable && Array.isArray(giscus) && giscus[0] && frontmatter.giscus
const isSearchable =
  Array.isArray(search) &&
  search[0] &&
  search[1].includes.includes('blog') &&
  frontmatter.search
const searchFilter =
  isSearchable && search[1].filter ? 'collection:blog' : undefined

const draftWarning = `這篇文章仍是草稿，只會出現在開發環境。`
---

<BaseLayout
  title={frontmatter.title}
  description={frontmatter.description}
  ogImage={frontmatter.ogImage}
  {pubDate}
  {lastModDate}
>
  <article
    class="post-document"
    data-pagefind-body={isSearchable ? '' : undefined}
    data-pagefind-filter={searchFilter}
  >
    <header class="post-header">
      <p class="field-kicker">FIELD NOTE / {series?.title ?? 'DEVELOPMENT'}</p>
      <h1>{frontmatter.title}</h1>
      {
        frontmatter.subtitle && (
          <p class="post-subtitle">{frontmatter.subtitle}</p>
        )
      }
      <PostMeta {pubDate} {lastModDate} {minutesRead} />
      <PostTaxonomy {post} />
    </header>

    <div class="post-layout">
      {
        tocEnabled && (
          <div class="post-toc">
            <div class="post-toc__inner">
              <Toc {headings} />
            </div>
          </div>
        )
      }
      <div class="prose post-content">
        {frontmatter.draft && <Warning html={draftWarning} />}
        <Content />
      </div>
    </div>
  </article>

  <Fragment slot="share">
    {shareEnabled && <ShareLink config={share[1]} />}
  </Fragment>
  {
    giscusEnabled && (
      <div slot="giscus" class="prose giscus-frame">
        <Giscus />
      </div>
    )
  }
  <ImageViewer selector=".post-content" options={{ title: 0, navbar: 0 }} />
</BaseLayout>
