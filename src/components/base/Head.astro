---
import { ClientRouter } from 'astro:transitions'
import { existsSync } from 'node:fs'
import { basename, join } from 'node:path'

import { withBasePath } from '~/utils/path'
import { SITE } from '~/config'

import type { SeoPageKind } from '~/types'

interface Props {
  title?: string
  description?: string
  ogImage?: string | boolean
  pubDate?: string
  lastModDate?: string
  pageKind?: SeoPageKind
  noindex?: boolean
  canonical?: string | false
  tags?: string[]
  section?: string
}

const {
  title,
  description,
  ogImage,
  pubDate,
  lastModDate,
  pageKind = pubDate ? 'article' : 'webpage',
  noindex = false,
  canonical,
  tags = [],
  section,
} = Astro.props

const pageTitle =
  title && title !== SITE.title ? `${title} - ${SITE.title}` : SITE.title
const socialTitle = title || SITE.title
const pageDescription = description || SITE.description
const canonicalURL =
  canonical === false
    ? undefined
    : new URL(canonical || Astro.url.pathname, Astro.site)
const pageURL = canonicalURL?.href || Astro.url.href

const ogImageExists = (filename: string) =>
  existsSync(join(process.cwd(), 'public', 'og-images', filename))

const generatedOgImage = ogImageExists(`${basename(Astro.url.pathname)}.png`)
  ? withBasePath('og-images', `${basename(Astro.url.pathname)}.png`)
  : undefined

const assignedOgImage =
  ogImage && ogImage !== true && ogImageExists(ogImage)
    ? withBasePath('og-images', ogImage)
    : undefined

const ogImageURL =
  ogImage === false
    ? undefined
    : new URL(
        assignedOgImage ||
          generatedOgImage ||
          withBasePath('og-images', 'og-image.png'),
        Astro.url
      ).href

const personId = new URL('/#person', SITE.website).href
const websiteId = new URL('/#website', SITE.website).href
const webPageId = `${pageURL}#webpage`
const articleId = `${pageURL}#article`

const personData = {
  '@type': 'Person',
  '@id': personId,
  'name': SITE.author,
  'url': SITE.website,
  ...(SITE.profiles.length > 0 && { sameAs: SITE.profiles }),
  ...(SITE.location && {
    homeLocation: {
      '@type': 'PostalAddress',
      'addressLocality': SITE.location.locality,
      'addressCountry': SITE.location.countryCode,
    },
  }),
}

const websiteData = {
  '@type': 'WebSite',
  '@id': websiteId,
  'url': SITE.website,
  'name': SITE.title,
  'description': SITE.description,
  'inLanguage': SITE.lang,
  'publisher': { '@id': personId },
}

const webPageType =
  pageKind === 'profile'
    ? 'ProfilePage'
    : pageKind === 'collection'
      ? 'CollectionPage'
      : 'WebPage'

const webPageData = {
  '@type': webPageType,
  '@id': webPageId,
  'url': pageURL,
  'name': pageTitle,
  'description': pageDescription,
  'inLanguage': SITE.lang,
  'isPartOf': { '@id': websiteId },
  ...(pageKind === 'profile' && { mainEntity: { '@id': personId } }),
  ...(pageKind === 'article' && { mainEntity: { '@id': articleId } }),
}

const blogPostingData = {
  '@type': 'BlogPosting',
  '@id': articleId,
  'headline': socialTitle,
  'description': pageDescription,
  'url': pageURL,
  'mainEntityOfPage': { '@id': webPageId },
  'inLanguage': SITE.lang,
  ...(ogImageURL && { image: ogImageURL }),
  ...(pubDate && { datePublished: pubDate }),
  ...(lastModDate && { dateModified: lastModDate }),
  ...(section && { articleSection: section }),
  ...(tags.length > 0 && { keywords: tags }),
  'author': { '@id': personId },
  'publisher': { '@id': personId },
}

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    personData,
    websiteData,
    webPageData,
    ...(pageKind === 'article' ? [blogPostingData] : []),
  ],
}
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="generator" content={Astro.generator} />
{noindex && <meta name="robots" content="noindex,follow" />}
<script is:inline>
  try {
    if (sessionStorage.getItem('field-reveal-seen') !== '1') {
      document.documentElement.classList.add(
        'scroll-reveal-enabled',
        'enter-anim'
      )
    }

    const contentEntranceKey = `field-content-entered:${location.pathname}`
    const contentEntranceSeen =
      sessionStorage.getItem(contentEntranceKey) === '1'
    document.documentElement.classList.toggle(
      'content-enter-anim',
      !contentEntranceSeen
    )
    if (!contentEntranceSeen) sessionStorage.setItem(contentEntranceKey, '1')
  } catch {
    /* storage unavailable: keep all content visible */
  }
</script>

<!-- Primary Metadata -->
<title>{pageTitle}</title>
<meta name="title" content={pageTitle} />
<meta name="description" content={pageDescription} />
<meta name="author" content={SITE.author} />

<!-- Color -->
<meta name="theme-color" content="" />
<meta name="color-scheme" content="light dark" />

<!-- Open Graph & Facebook -->
<meta
  property="og:type"
  content={pageKind === 'article' ? 'article' : 'website'}
/>
<meta property="og:url" content={pageURL} />
<meta property="og:title" content={socialTitle} />
<meta property="og:description" content={pageDescription} />
{
  ogImageURL && (
    <>
      <meta property="og:image" content={ogImageURL} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:type" content="image/png" />
      <meta property="og:image:alt" content={`${socialTitle} 分享圖片`} />
    </>
  )
}
<meta property="og:site_name" content={SITE.title} />
<meta property="og:locale" content={SITE.ogLocale} />
{
  pageKind === 'article' && pubDate && (
    <>
      <meta property="article:author" content={SITE.author} />
      <meta property="article:published_time" content={pubDate} />
      {lastModDate && (
        <meta property="article:modified_time" content={lastModDate} />
      )}
      {section && <meta property="article:section" content={section} />}
      {tags.map((tag) => (
        <meta property="article:tag" content={tag} />
      ))}
    </>
  )
}

<!-- Twitter -->
<meta
  name="twitter:card"
  content={ogImageURL ? 'summary_large_image' : 'summary'}
/>
<meta name="twitter:title" content={socialTitle} />
<meta name="twitter:description" content={pageDescription} />
{
  ogImageURL && (
    <>
      <meta name="twitter:image" content={ogImageURL} />
      <meta name="twitter:image:alt" content={`${socialTitle} 分享圖片`} />
    </>
  )
}

<!-- Canonical URL -->
{canonicalURL && <link rel="canonical" href={canonicalURL} />}

<!-- Language alternatives -->
{
  canonicalURL && !noindex && (
    <>
      <link rel="alternate" hreflang={SITE.lang} href={canonicalURL} />
      <link rel="alternate" hreflang="x-default" href={canonicalURL} />
    </>
  )
}

<!-- LLM-friendly site summary -->
<link rel="describedby" type="text/plain" href={withBasePath('/llms.txt')} />

<!-- Icon -->
<link rel="icon" type="image/svg+xml" href={withBasePath('/favicon.svg')} />
<link rel="icon" sizes="32x32" href={withBasePath('/favicon.ico')} />
<link rel="apple-touch-icon" href={withBasePath('/apple-touch-icon.png')} />

<!-- Manifest -->
<link rel="manifest" href={withBasePath('/app.webmanifest')} />

<!-- Sitemap -->
<link
  rel="sitemap"
  type="application/xml"
  href={withBasePath('/sitemap.xml')}
/>

<!-- RSS -->
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${SITE.title} RSS`}
  href={withBasePath('/rss.xml')}
/>

<!-- Schema.org structured data -->
<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(structuredData)}
/>

<ClientRouter />
