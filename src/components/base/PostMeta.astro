---
import { formatDate } from '~/utils/datetime'

interface Props {
  pubDate: string
  lastModDate?: string
  minutesRead: number
}

const { pubDate, lastModDate, minutesRead } = Astro.props
---

<div class="post-meta">
  <span
    ><small>Published</small><time datetime={pubDate}
      >{formatDate(pubDate)}</time
    ></span
  >
  {
    minutesRead > 0 && (
      <span>
        <small>Reading</small>
        {minutesRead} min
      </span>
    )
  }
  {
    lastModDate && (
      <span>
        <>
          <small>Revised</small>
          <time datetime={lastModDate}>{formatDate(lastModDate)}</time>
        </>
      </span>
    )
  }
</div>
