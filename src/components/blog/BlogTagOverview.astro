---
import TagChips from '~/components/blog/TagChips.astro'
import { getAllBlogPosts, getTagSummaries } from '~/utils/blog'

const posts = await getAllBlogPosts()
const items = getTagSummaries(posts)
---

{
  items.length > 0 && (
    <section class="mb-12">
      <h2 class="mb-2">Tags</h2>
      <p class="mt-0! mb-4! op-60">透過主題標籤交叉瀏覽系列文章與單篇文章。</p>
      <TagChips items={items} limit={12} />
    </section>
  )
}
