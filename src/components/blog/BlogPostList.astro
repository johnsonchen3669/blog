---
import { render } from 'astro:content'

import ListItem from '~/components/views/ListItem.astro'
import AdSlot from '~/components/ads/AdSlot.astro'
import { getBlogPostPath } from '~/utils/blog'

import type { BlogPost } from '~/utils/blog'

interface Props {
  posts: BlogPost[]
}

const { posts } = Astro.props

// 列表每 N 篇穿插一個廣告版位（0003 定案；末篇後不插）。
const LIST_AD_EVERY = 5
---

<div class="blog-post-list" aria-label="Blog post list">
  {
    posts.length === 0 ? (
      <div class="empty-note">目前還沒有公開文章。</div>
    ) : (
      posts.map(async (post, idx) => {
        const { remarkPluginFrontmatter } = await render(post)
        const minutesRead =
          post.data.minutesRead || remarkPluginFrontmatter.minutesRead

        return (
          <>
            <ListItem
              idx={idx}
              collectionType="blog"
              href={getBlogPostPath(post)}
              redirect={post.data.redirect}
              postSlug={post.id}
              title={post.data.title}
              video={post.data.video}
              radio={post.data.radio}
              date={post.data.pubDate}
              minutesRead={minutesRead}
              platform={post.data.platform}
            />
            {/* 每 5 篇穿插一個廣告版位（0003 定案；首頁無列表不含） */}
            {(idx + 1) % LIST_AD_EVERY === 0 && idx < posts.length - 1 && (
              <AdSlot placement="listInline" />
            )}
          </>
        )
      })
    )
  }
</div>
