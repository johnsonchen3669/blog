---
import Link from '~/components/base/Link.astro'

import {
  getPostSeriesMeta,
  getPostSeriesSlug,
  getPostTags,
  getSeriesPath,
} from '~/utils/blog'

import type { BlogPost } from '~/utils/blog'

interface Props {
  post: BlogPost
}

const { post } = Astro.props
const seriesSlug = getPostSeriesSlug(post)
const seriesMeta = getPostSeriesMeta(post)
const tags = getPostTags(post)
---

{
  (seriesMeta || tags.length > 0) && (
    <div class="field-taxonomy" data-pagefind-ignore>
      {seriesMeta && seriesSlug && (
        <Link
          class="field-taxonomy__series"
          href={getSeriesPath(seriesSlug)}
          title={seriesMeta.title}
        >
          <span>
            <span class={seriesMeta.icon} aria-hidden="true" />
            <span>{seriesMeta.title}</span>
          </span>
        </Link>
      )}
      {tags.map((tag) => (
        <Link class="field-taxonomy__tag" href={tag.path} title={tag.name}>
          <span>{`#${tag.name}`}</span>
        </Link>
      ))}
    </div>
  )
}
