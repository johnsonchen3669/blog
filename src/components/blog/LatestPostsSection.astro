---
import BlogPostList from '~/components/blog/BlogPostList.astro'
import Link from '~/components/base/Link.astro'

import { getAllBlogPosts } from '~/utils/blog'
import { withBasePath } from '~/utils/path'

const latestPosts = (await getAllBlogPosts()).slice(0, 5)
---

<div class="mt-20 mb-4 flex flex-wrap items-baseline justify-between gap-4">
  <h2 class="m-0!">最新文章</h2>
  <Link
    class="text-sm op-60 hover:op-100 no-underline"
    href={withBasePath('/blog/')}
  >
    查看全部
  </Link>
</div>

<BlogPostList posts={latestPosts} />
