---
import SeriesGrid from '~/components/blog/SeriesGrid.astro'
import { getAllBlogPosts, getSeriesSummaries } from '~/utils/blog'

const posts = await getAllBlogPosts()
const items = getSeriesSummaries(posts)
---

{
  items.length > 0 && (
    <section class="blog-series-overview">
      <span class="utility-label">Learning routes</span>
      <h2>系列文章</h2>
      <p>從系列入口快速瀏覽完整學習路線。</p>
      <SeriesGrid {items} />
    </section>
  )
}
