---
import LogoButton from '~/components/widgets/LogoButton.astro'
import SearchSwitch from '~/components/widgets/SearchSwitch.astro'
import ThemeSwitch from '~/components/widgets/ThemeSwitch.astro'
import RssLink from '~/components/widgets/RssLink.astro'
import Link from '~/components/base/Link.astro'
import { UI } from '~/config'
import { resolvePath } from '~/utils/path'
---

<header class="site-header">
  <div class="site-header__inner">
    <LogoButton />
    <nav class="field-nav" aria-label="主要導覽">
      {
        UI.internalNavs.map((item) => (
          <Link
            class="field-nav__link"
            href={resolvePath(item.path)}
            aria-current={
              Astro.url.pathname.startsWith(resolvePath(item.path))
                ? 'page'
                : undefined
            }
          >
            {'text' in item ? item.text : item.title}
          </Link>
        ))
      }
    </nav>
    <div class="field-tools" aria-label="網站工具">
      <Link
        class="field-tool field-tool--github"
        href="https://github.com/johnsonchen3669"
        external={true}
        newTab={true}
        title="Johnson Chen on GitHub"
      >
        <span class="i-uil-github-alt" aria-hidden="true"></span>
      </Link>
      <SearchSwitch />
      <ThemeSwitch />
      <RssLink />
    </div>
  </div>
</header>
