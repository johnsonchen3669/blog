---
import RenderPost from '~/components/views/RenderPost.astro'
import {
  getAllBlogPosts,
  getBlogPostLegacyRouteParam,
  getBlogPostRouteParam,
} from '~/utils/blog'

import type { CollectionEntry } from 'astro:content'

interface Props {
  post: CollectionEntry<'blog'>
  canonicalSlug: string
  isLegacyPath?: boolean
}

export async function getStaticPaths() {
  const posts: CollectionEntry<'blog'>[] = await getAllBlogPosts()

  return posts.flatMap((post) => {
    const canonicalSlug = getBlogPostRouteParam(post)
    const legacySlug = getBlogPostLegacyRouteParam(post)
    const paths: { params: { slug: string }; props: Props }[] = [
      {
        params: { slug: canonicalSlug },
        props: { post, canonicalSlug },
      },
    ]

    if (canonicalSlug !== legacySlug) {
      paths.push({
        params: { slug: legacySlug },
        props: { post, canonicalSlug, isLegacyPath: true },
      })
    }

    return paths
  })
}

const { post, canonicalSlug, isLegacyPath = false } = Astro.props

if (isLegacyPath && Astro.params.slug !== canonicalSlug) {
  return Astro.redirect(`/blog/${canonicalSlug}/`, 301)
}
---

<RenderPost {post} isCommentable={true} />
